generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  barbecues    Barbecue[]
}

model Barbecue {
  id           String         @id @default(cuid())
  slug         String         @unique
  eventName    String
  eventDay     String // ISO yyyy-mm-dd
  startTime    String // HH:mm
  endTime      String // HH:mm
  eventAddress String
  eventCity    String
  eventHint    String
  alcoholMode  String
  tier         String
  men          Int
  women        Int
  kids         Int
  // Totais do snapshot, em centavos — o evento salvo não muda quando o seed de preços muda
  totalCents    Int
  perAdultCents Int
  meatListKg    Float
  pixType      String?
  pixKey       String?
  // organizador escolhe exibir quem pagou na página pública (default: só ele vê)
  showPaidPublicly Boolean @default(false)
  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId      String
  items        BarbecueItem[]
  rsvps        Rsvp[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Rsvp {
  id         String   @id @default(cuid())
  barbecue   Barbecue @relation(fields: [barbecueId], references: [id], onDelete: Cascade)
  barbecueId String
  guestName  String
  response   String // vou | levo-alguem | nao-vou
  // marcado pelo organizador no painel de cobranças
  paid       Boolean  @default(false)
  paidAt     DateTime?
  // segredo devolvido ao convidado para editar a própria resposta (sem conta)
  token      String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([barbecueId])
}

// Catálogo de referência (fatia 8): fonte de runtime dos níveis/preços.
// Seed idempotente a partir do TIERS de packages/calculator (prisma/seed.cjs).
model CatalogTier {
  id                 String        @id // basico | medio | gourmet
  name               String
  badge              String
  priceLabel         String
  pitch              String
  charcoalName       String
  charcoalPriceCents Int
  sortOrder          Int
  items              CatalogItem[]
}

model CatalogItem {
  id             String      @id @default(cuid())
  tier           CatalogTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  tierId         String
  kind           String // cut | side | optional
  name           String
  unitPriceCents Int
  proportion     Float? // cut
  unit           String? // side/optional
  per            String? // side: adult | guest
  factor         Float? // side
  qty            Float? // optional
  sortOrder      Int

  @@unique([tierId, kind, name])
}

model BarbecueItem {
  id             String   @id @default(cuid())
  barbecue       Barbecue @relation(fields: [barbecueId], references: [id], onDelete: Cascade)
  barbecueId     String
  itemId         String // id de domínio (ex.: medio-picanha) para reabrir edição
  name           String
  category       String
  unit           String
  qty            Float
  unitPriceCents Int

  @@index([barbecueId])
}

// Pedido de orçamento (fatia 10): lead anônimo — sem conta, contato só pelo WhatsApp.
// Distribuição aos açougues é manual por enquanto (status muda via psql).
model QuoteRequest {
  id           String             @id @default(cuid())
  status       String             @default("novo") // novo | enviado | respondido | cancelado
  contactName  String
  whatsapp     String // E.164, ex.: +5511988881234
  consent      Boolean
  eventDay     String // ISO yyyy-mm-dd
  startTime    String // HH:mm
  endTime      String // HH:mm
  cep          String // 8 dígitos
  eventCity    String
  eventAddress String             @default("")
  eventHint    String             @default("")
  alcoholMode  String
  tier         String
  men          Int
  women        Int
  kids         Int
  // Totais de referência do snapshot, em centavos
  totalCents   Int
  meatListKg   Float
  items        QuoteRequestItem[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([cep])
}

model QuoteRequestItem {
  id             String       @id @default(cuid())
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  quoteRequestId String
  itemId         String
  name           String
  category       String
  unit           String
  qty            Float
  unitPriceCents Int

  @@index([quoteRequestId])
}
